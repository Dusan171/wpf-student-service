<Window x:Class="StudentService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:local="clr-namespace:StudentService"
        mc:Ignorable="d"
        Title="Studen Service" 
        WindowStartupLocation="CenterScreen"
        Width="{Binding SystemParameters.PrimaryScreenWidth, ConverterParameter=0.75}" 
        Height="{Binding SystemParameters.PrimaryScreenHeight, ConverterParameter=0.75}"
        MinWidth="800" MinHeight="600">
    <Grid>
        <!-- Menu Bar -->
        <Menu VerticalAlignment="Top">
            <MenuItem Header="File">
                <MenuItem Header="New" />
                <MenuItem Header="Open" />
                <MenuItem Header="Save" />
                <MenuItem Header="Exit" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Students" />
                <MenuItem Header="Professors" />
                <MenuItem Header="Subjects" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar VerticalAlignment="Top" Margin="0,25,0,0">
            <!-- Add Button -->
            <Button Name="AddButton" ToolTip="Create new entity (Ctrl+N)" Click="AddButton_Click">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesome Icon="Plus" Width="16" Height="16" Foreground="Black" Margin="2"/>
                    <TextBlock Text="Add" Margin="2,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- Edit Button -->
            <Button Name="EditButton" ToolTip="Edit selected entity (Ctrl+E)" Click="Button_ClickUpdate">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesome Icon="Edit" Width="16" Height="16" Foreground="Black" Margin="2"/>
                    <TextBlock Text="Edit" Margin="2,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- Delete Button -->
            <Button Name="DeleteButton" ToolTip="Delete selected entity (Ctrl+D)" Click="Button_ClickDelete">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesome Icon="Trash" Width="16" Height="16" Foreground="Black" Margin="2"/>
                    <TextBlock Text="Delete" Margin="2,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- Search Field -->
            <TextBox Name="SearchBox" Width="200" Margin="10,0,0,0" ToolTip="Enter search criteria"/>

            <!-- Search Button -->
            <Button Name="SearchButton" ToolTip="Search (Ctrl+F)" Click="SearchButton_Click">
                <StackPanel Orientation="Horizontal">
                    <fa:FontAwesome Icon="Search" Width="16" Height="16" Foreground="Black" Margin="2"/>
                    <TextBlock Text="Search" Margin="2,0,0,0"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- Central Panel with Tabs -->
        <TabControl x:Name="mainTab" Margin="10,75,10,25" >
            <!-- Students Tab -->
            <TabItem Header="Students">
                <DataGrid ItemsSource="{Binding Students}" 
                          SelectedItem="{Binding SelectedStudent}" 
                          IsReadOnly="True" 
                          AutoGenerateColumns="False" 
                          Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="*" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Surname" Binding="{Binding Surname}" Width="*" />
                        <DataGridTextColumn Header="Year of Study" Binding="{Binding YearOfStudy}" Width="*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <!-- Professors Tab -->
            <TabItem Header="Professors">
                <DataGrid ItemsSource="{Binding Professors}" 
                          SelectedItem="{Binding SelectedProfessor}" 
                          IsReadOnly="True" 
                          AutoGenerateColumns="False" 
                          Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Surname" Binding="{Binding Surname}" Width="*" />
                        <DataGridTextColumn Header="Vocation" Binding="{Binding Vocation}" Width="*" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <!-- Subjects Tab -->
            <TabItem Header="Subjects">
                <DataGrid ItemsSource="{Binding Subjects}" 
                          SelectedItem="{Binding SelectedSubject}" 
                          IsReadOnly="True" 
                          AutoGenerateColumns="False" 
                          Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Espb" Binding="{Binding Espb}" Width="*" />
                        <DataGridTextColumn Header="Year" Binding="{Binding YearOfStudy}" Width="*" />
                        <DataGridTextColumn Header="Semester" Binding="{Binding Semester}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <!-- Status Bar -->
        <StatusBar VerticalAlignment="Bottom">
            <DockPanel LastChildFill="True">
                <TextBlock Text="StudentService - " DockPanel.Dock="Left" />
                <TextBlock x:Name="CurrentTabTextBlock" DockPanel.Dock="Left" Margin="0,0,700,0"/>
                <TextBlock x:Name="DateTimeTextBlock" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            </DockPanel>
        </StatusBar>
    </Grid>
</Window>