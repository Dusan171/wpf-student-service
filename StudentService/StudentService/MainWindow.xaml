<Window x:Class="StudentService.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService"
        mc:Ignorable="d"
        Title="Studen Service" 
         WindowStartupLocation="CenterScreen"
         Width="{Binding SystemParameters.PrimaryScreenWidth, ConverterParameter=0.75}" 
         Height="{Binding SystemParameters.PrimaryScreenHeight, ConverterParameter=0.75}"
        >

    <Grid Height="287" Width="643">
        <!-- Menu Bar -->
        <Menu VerticalAlignment="Top">
            <MenuItem Header="File">
                <MenuItem Header="New" />
                <MenuItem Header="Open" />
                <MenuItem Header="Save" />
                <MenuItem Header="Exit" />
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Students" />
                <MenuItem Header="Professors" />
                <MenuItem Header="Subjects" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" />
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar VerticalAlignment="Top" Margin="0,25,0,0">
            <Button Content="Add" />
            <Button Content="Edit" />
            <Button Content="Delete" />
        </ToolBar>

        <!-- Central Panel with Tabs -->
        <TabControl Margin="10,75,10,25">
            <TabItem Header="Studenti">
                <!-- DataGrid for Students -->
                <DataGrid AutoGenerateColumns="True" />
            </TabItem>
            <TabItem Header="Profesori">
                <!-- DataGrid for Professors -->
                <DataGrid AutoGenerateColumns="True" />
            </TabItem>
            <TabItem Header="Predmeti">
                <!-- DataGrid for Subjects -->
                <DataGrid AutoGenerateColumns="True" />
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <StatusBar VerticalAlignment="Bottom">
            <TextBlock Text="Status: Ready" />
        </StatusBar>
    </Grid>
</Window>
