<Window x:Class="StudentService.Gui.UpdateIndex"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="UpdateIndex" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Label and Textbox for Id -->
        <Label Content="Id:" VerticalAlignment="Center" />
        <TextBox x:Name="IdTextBox" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="100,0,0,0" Grid.Row="0"/>

        <!-- Label and Textbox for CourseCode -->
        <Label Content="CourseCode:" VerticalAlignment="Center" Grid.Row="1"/>
        <TextBox x:Name="CourseCodeTextBox" Text="{Binding CourseCode, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="100,0,0,0" Grid.Row="1"/>

        <!-- Label and Textbox for RegisterNumber -->
        <Label Content="RegisterNumber:" VerticalAlignment="Center" Grid.Row="2"/>
        <TextBox x:Name="RegisterNumberTextBox" Text="{Binding RegisterNumber, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="100,0,0,0" Grid.Row="2"/>

        <!-- Label and Textbox for RegisterYear -->
        <Label Content="RegisterYear:" VerticalAlignment="Center" Grid.Row="3"/>
        <TextBox x:Name="RegisterYearTextBox" Text="{Binding RegisterYear, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="100,0,0,0" Grid.Row="3"/>

        <!-- Button to update the index -->
        <Button Content="Update Index" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,10,0,0" Width="150" Height="40" Grid.Row="4" Click="UpdateIndexButton_Click"/>
    </Grid>
</Window>
