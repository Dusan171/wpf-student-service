<Window x:Class="StudentService.Gui.UpdateStudent"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="UpdateStudent" Height="400" Width="300">
    <Grid Margin="10">
        <Label Content="Surname:" VerticalAlignment="Top" />
        <TextBox x:Name="SurnameTextBox" Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,0,0,0" />

        <Label Content="Name:" VerticalAlignment="Top" Margin="0,30,0,0" />
        <TextBox x:Name="NameTextBox" Text="{Binding StudName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,30,0,0" />

        <Label Content="Date of Birth:" VerticalAlignment="Top" Margin="0,60,0,0" />
        <DatePicker x:Name="DateOfBirthPicker" SelectedDate="{Binding DateOfBirth, Mode=TwoWay}" VerticalAlignment="Top" Margin="100,60,0,0" />

        <Label Content="Address:" VerticalAlignment="Top" Margin="0,90,0,0" />
        <TextBox x:Name="AddressTextBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,90,0,0" />

        <Label Content="Phone:" VerticalAlignment="Top" Margin="0,120,0,0" />
        <TextBox x:Name="PhoneTextBox" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,120,0,0" />

        <Label Content="Email:" VerticalAlignment="Top" Margin="0,150,0,0" />
        <TextBox x:Name="EmailTextBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,150,0,0" />

        <Label Content="Index:" VerticalAlignment="Top" Margin="0,180,0,0" />
        <TextBox x:Name="IndexTextBox" Text="{Binding Index, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,180,0,0" />

        <Label Content="Year of Study:" VerticalAlignment="Top" Margin="0,210,0,0" />
        <TextBox x:Name="YearOfStudyTextBox" Text="{Binding YearOfStudy, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,210,0,0" />

        <Label Content="Status:" VerticalAlignment="Top" Margin="0,240,0,0" />
        <ComboBox x:Name="StatusComboBox" ItemsSource="{Binding StudentStatuses}" SelectedItem="{Binding Status, Mode=TwoWay}" VerticalAlignment="Top" Margin="100,240,0,0"/>

        <Label Content="Average Grade:" VerticalAlignment="Top" Margin="0,270,0,0" />
        <TextBox x:Name="AvgGradeTextBox" Text="{Binding AvgGrade, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,270,0,0" />

        <Button Content="Update Student" VerticalAlignment="Top" Margin="10,300,0,0" Width="100" Click="UpdateStudentButton_Click" />
    </Grid>
</Window>
