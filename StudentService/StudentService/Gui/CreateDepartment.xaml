<Window x:Class="StudentService.Gui.CreateDepartment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CreateDepartment" Height="450" Width="800">
    <Grid Margin="10">
        <Label Content="Id:" VerticalAlignment="Top" />
        <TextBox x:Name="NameTextBox" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,0,0,0"/>

        <Label Content="Code:" VerticalAlignment="Top" Margin="0,30,0,0"/>
        <TextBox x:Name="CodeTextBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,30,0,0" />

        <Label Content="HeadProfessor:" VerticalAlignment="Top" Margin="0,60,0,0" />
        <TextBox x:Name="HeadProfessorTextBox" Text="{Binding HeadProfessor, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,60,0,0"/>

        <Button Content="Add Department" VerticalAlignment="Top" Margin="10,180,0,0" Width="100" Click="AddDepartmentButton_Click" />


    </Grid>
</Window>
