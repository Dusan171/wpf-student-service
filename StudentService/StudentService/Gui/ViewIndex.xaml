<Window x:Class="StudentService.Gui.ViewIndex"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="ViewIndex" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Button panel -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button Content="Create Index" Click="Button_ClickCreate" Width="100" Margin="0,0,10,0" />
            <Button Content="Update Index" Click="Button_ClickUpdate" Width="100" Margin="0,0,10,0" />
            <Button Content="Delete Index" Click="Button_ClickDelete" Width="100" />
        </StackPanel>

        <!-- DataGrid to display the list of professors -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Index}" SelectedItem="{Binding SelectedIndex}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,50,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                <DataGridTextColumn Header="CourseCode" Binding="{Binding CourseCode}" />
                <DataGridTextColumn Header="RegisterNumber" Binding="{Binding RegisterNumber}" />
                <DataGridTextColumn Header="RegisterYear" Binding="{Binding RegisterYear}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
