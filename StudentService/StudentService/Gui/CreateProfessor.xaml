<Window x:Class="StudentService.Gui.CreateProfessor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Professor" Height="500" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Surname:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="5" />

        <Label Content="Name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="5" />

        <Label Content="Date of Birth:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
        <DatePicker SelectedDate="{Binding DateOfBirth, Mode=TwoWay}" Grid.Row="2" Grid.Column="1" Margin="5" />

        <Label Content="Address:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="5" />

        <Label Content="Phone:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Margin="5" />

        <Label Content="Email:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1" Margin="5" />

        <Label Content="ID Number:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Text="{Binding IdNumber, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Margin="5" />

        <Label Content="Vocation:" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Text="{Binding Vocation, UpdateSourceTrigger=PropertyChanged}" Grid.Row="7" Grid.Column="1" Margin="5" />

        <Label Content="Years of Service:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" />
        <TextBox Text="{Binding YearsOfService, UpdateSourceTrigger=PropertyChanged}" Grid.Row="8" Grid.Column="1" Margin="5" />

        <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Potvrdi" Width="100" Margin="5" IsEnabled="{Binding AreFieldsValid}" Click="PotvrdiButton_Click" />
            <Button Content="Odustani" Width="100" Margin="5" Click="OdustaniButton_Click" />
        </StackPanel>
    </Grid>
</Window>