<Window x:Class="StudentService.Gui.CreateSubject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CreateSubject" Height="500" Width="800">
    <Grid Margin="20">
        <!-- Define Rows and Columns -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Label and TextBox for Id -->
        <Label Content="Id:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,5"/>
        <TextBox x:Name="IdTextBox" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" Margin="10" />

        <!-- Label and TextBox for Code -->
        <Label Content="Code:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,5"/>
        <TextBox x:Name="CodeTextBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="10" />

        <!-- Label and TextBox for Name -->
        <Label Content="Name:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,5"/>
        <TextBox x:Name="NameTextBox" Text="{Binding NameSubj, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1" Margin="10" />

        <!-- Label and ComboBox for Semester -->
        <Label Content="Semester:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,5"/>
        <ComboBox x:Name="SemesterComboBox" ItemsSource="{Binding AvailableSemesters}" SelectedItem="{Binding SemesterStud}" VerticalAlignment="Center" Grid.Row="3" Grid.Column="1" Margin="10" />

        <!-- Label and TextBox for Year of Study -->
        <Label Content="Year of Study:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,5"/>
        <TextBox x:Name="YearofStudyTextBox" Text="{Binding YearOfStudy, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.Row="4" Grid.Column="1" Margin="10" />

        <!-- Label and ComboBox for Professor -->
        <Label Content="Professor:" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" Margin="0,5"/>
        <ComboBox x:Name="ProfessorComboBox" ItemsSource="{Binding Professors}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedProfessor}" VerticalAlignment="Center" Grid.Row="5" Grid.Column="1" Margin="10" />

        <!-- Label and TextBox for ESPB -->
        <Label Content="Espb:" VerticalAlignment="Center" Grid.Row="6" Grid.Column="0" Margin="0,5"/>
        <TextBox x:Name="EspbTextBox" Text="{Binding Espb, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Grid.Row="6" Grid.Column="1" Margin="10" />

        <!-- Action Buttons -->
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Potvrdi" Width="100" Margin="5" IsEnabled="{Binding AreFieldsValid}" Click="PotvrdiButton_Click" />
            <Button Content="Odustani" Width="100" Margin="5" Click="OdustaniButton_Click" />
        </StackPanel>
    </Grid>
</Window>

