<Window x:Class="StudentService.Gui.CreateSubject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CreateSubject" Height="450" Width="800">
    <Grid Margin="10">
        <Label Content="Id:" VerticalAlignment="Top" />
        <TextBox x:Name="IdTextBox" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,0,0,0" />

        <Label Content="Code:" VerticalAlignment="Top" Margin="0,30,0,0" />
        <TextBox x:Name="CodeTextBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,30,0,0" />

        <Label Content="Name:" VerticalAlignment="Top" Margin="0,90,0,0" />
        <TextBox x:Name="NameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,90,0,0" />

        <Label Content="Semester:" VerticalAlignment="Top" Margin="0,120,0,0" />
        <TextBox x:Name="SemesterTextBox" Text="{Binding Semester, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,120,0,0" />

        <Label Content="YearofStudy:" VerticalAlignment="Top" Margin="0,150,0,0" />
        <TextBox x:Name="YearofStudyTextBox" Text="{Binding YearofStudy, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,150,0,0" />

        <Label Content="Professor:" VerticalAlignment="Top" Margin="0,180,0,0" />
        <TextBox x:Name="ProfessorTextBox" Text="{Binding Professor, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,180,0,0" />

        <Label Content="Espb:" VerticalAlignment="Top" Margin="0,210,0,0" />
        <TextBox x:Name="EspbTextBox" Text="{Binding Espb, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,210,0,0" />

        <Button Content="Add Subject" VerticalAlignment="Top" Margin="10,300,0,0" Width="100" Click="AddSubjectButton_Click" />

    </Grid>
</Window>
