<Window x:Class="StudentService.Gui.UpdateAddress"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Update Address" Height="300" Width="500">
    <Grid Margin="10">
        <Label Content="Street:" VerticalAlignment="Top" />
        <TextBox x:Name="StreetTextBox" Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,0,0,0" />

        <Label Content="Number:" VerticalAlignment="Top" Margin="0,30,0,0" />
        <TextBox x:Name="NumberTextBox" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,30,0,0" />

        <Label Content="Town:" VerticalAlignment="Top" Margin="0,60,0,0" />
        <TextBox x:Name="TownTextBox" Text="{Binding Town, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,60,0,0" />

        <Label Content="Country:" VerticalAlignment="Top" Margin="0,90,0,0" />
        <TextBox x:Name="CountryTextBox" Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,90,0,0" />

        <Button Content="Update Address" VerticalAlignment="Top" Margin="10,130,0,0" Width="120" Click="UpdateAddressButton_Click" />
    </Grid>
</Window>
