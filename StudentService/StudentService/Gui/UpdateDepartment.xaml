<Window x:Class="StudentService.Gui.UpdateDepartment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="UpdateDepartment" Height="400" Width="300">
    <Grid Margin="10">
        <Label Content="Code:" VerticalAlignment="Top" />
        <TextBox x:Name="CodeTextBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,0,0,0" />

        <Label Content="Name:" VerticalAlignment="Top" Margin="0,30,0,0" />
        <TextBox x:Name="NameTextBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,30,0,0" />

        <Label Content="Head Professor ID:" VerticalAlignment="Top" Margin="0,60,0,0" />
        <TextBox x:Name="HeadProfessorTextBox" Text="{Binding HeadProfessor.Id, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,60,0,0" />

        <Label Content="Professors:" VerticalAlignment="Top" Margin="0,90,0,0" />
        <TextBox x:Name="ProfessorsTextBox" Text="{Binding Professors, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,90,0,0" />

        <Button Content="Update Department" VerticalAlignment="Top" Margin="10,300,0,0" Width="100" Click="UpdateDepartmentButton_Click" />
    </Grid>
</Window>
