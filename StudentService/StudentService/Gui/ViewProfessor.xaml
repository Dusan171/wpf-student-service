<Window x:Class="StudentService.Gui.ViewProfessors"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="ViewProfessors" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Button panel -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button Content="Create Professor" Click="Button_ClickCreate" Width="100" Margin="0,0,10,0" />
            <Button Content="Update Professor" Click="Button_ClickUpdate" Width="100" Margin="0,0,10,0" />
            <Button Content="Delete Professor" Click="Button_ClickDelete" Width="100" />
        </StackPanel>

        <!-- DataGrid to display the list of professors -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Professors}" SelectedItem="{Binding SelectedProfessor}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,50,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Surname" Binding="{Binding Surname}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                <DataGridTextColumn Header="Date of Birth" Binding="{Binding DateOfBirth}" />
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" />
                <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" />
                <DataGridTextColumn Header="Id Number" Binding="{Binding IdNumber}" />
                <DataGridTextColumn Header="Vocation" Binding="{Binding Vocation}" />
                <DataGridTextColumn Header="Years of Service" Binding="{Binding YearsOfService}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
