<Window x:Class="StudentService.Gui.CreateGrade"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="CreateGrade" Height="400" Width="400">
    <Grid Margin="10">
        <Label Content="Student ID:" VerticalAlignment="Top" />
        <TextBox x:Name="StudentIdTextBox" Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="120,0,0,0" />

        <Label Content="Subject ID:" VerticalAlignment="Top" Margin="0,40,0,0" />
        <TextBox x:Name="SubjectIdTextBox" Text="{Binding SubjectId, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="120,40,0,0" />

        <Label Content="Grade Value:" VerticalAlignment="Top" Margin="0,80,0,0" />
        <TextBox x:Name="GradeValueTextBox" Text="{Binding GradeValue, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="120,80,0,0" />

        <Label Content="Date:" VerticalAlignment="Top" Margin="0,120,0,0" />
        <DatePicker x:Name="GradeDatePicker" SelectedDate="{Binding GradeDate, Mode=TwoWay}" VerticalAlignment="Top" Margin="120,120,0,0" />

        <Button Content="Add Grade" VerticalAlignment="Top" Margin="10,200,0,0" Width="100" Click="AddGradeButton_Click" />
    </Grid>
</Window>
