<Window x:Class="StudentService.Gui.UpdateGrade"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="UpdateGrade" Height="350" Width="300">
    <Grid Margin="10">
        <Label Content="Student ID:" VerticalAlignment="Top" />
        <TextBox x:Name="StudentIdTextBox" Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,0,0,0" />

        <Label Content="Subject ID:" VerticalAlignment="Top" Margin="0,30,0,0" />
        <TextBox x:Name="SubjectIdTextBox" Text="{Binding SubjectId, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,30,0,0" />

        <Label Content="Value:" VerticalAlignment="Top" Margin="0,60,0,0" />
        <TextBox x:Name="ValueTextBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Top" Margin="100,60,0,0" />

        <Label Content="Date:" VerticalAlignment="Top" Margin="0,90,0,0" />
        <DatePicker x:Name="DatePicker" SelectedDate="{Binding Date, Mode=TwoWay}" VerticalAlignment="Top" Margin="100,90,0,0" />

        <Button Content="Update Grade" VerticalAlignment="Top" Margin="10,150,0,0" Width="100" Click="UpdateGradeButton_Click" />
    </Grid>
</Window>
