<Window x:Class="StudentService.Gui.ViewDepartment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="ViewDepartment" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"  />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button Content="Create Department" Click="Button_ClickCreate" Width="100" Margin="0,0,10,0" />
            <Button Content="Update Department" Click="Button_ClickUpdate" Width="100" Margin="0,0,10,0" />
            <Button Content="Delete Department" Click="Button_ClickDelete" Width="100" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Department}" SelectedItem="{Binding SelectedDepartment}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,50,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" />
                <DataGridTextColumn Header="HeadProfessor" Binding="{Binding HeadProfessor}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
