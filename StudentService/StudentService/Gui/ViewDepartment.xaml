<Window x:Class="StudentService.Gui.ViewDepartment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="ViewDepartment" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"  />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

       
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,10">
            <Button Content="Create Department" Click="Button_ClickCreate" Width="120" Margin="0,0,10,0" Style="{StaticResource ButtonStyle}" />
            <Button Content="Update Department" Click="Button_ClickUpdate" Width="120" Margin="0,0,10,0" Style="{StaticResource ButtonStyle}" />
            <Button Content="Delete Department" Click="Button_ClickDelete" Width="120" Style="{StaticResource ButtonStyle}" />
        </StackPanel>

        <!-- DataGrid displaying departments -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" IsReadOnly="True" AutoGenerateColumns="False" Margin="10,0,10,0" 
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionMode="Single" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="*"/>
                <DataGridTextColumn Header="HeadProfessor" Binding="{Binding HeadProfessor.Name}" Width="*" />
       
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
