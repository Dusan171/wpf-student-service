<Window x:Class="StudentService.Gui.ViewGrade"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentService.Gui"
        mc:Ignorable="d"
        Title="ViewGrades" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Button panel -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
            <Button Content="Create Grade" Click="Button_ClickCreate" Width="100" Margin="0,0,10,0" />
            <Button Content="Update Grade" Click="Button_ClickUpdate" Width="100" Margin="0,0,10,0" />
            <Button Content="Delete Grade" Click="Button_ClickDelete" Width="100" />
        </StackPanel>

        <!-- DataGrid to display the list of grades -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Grades}" SelectedItem="{Binding SelectedGrade}" IsReadOnly="True" AutoGenerateColumns="False" Margin="0,50,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Student ID" Binding="{Binding PassedStudent.Id}" />
                <DataGridTextColumn Header="Subject ID" Binding="{Binding Subject.Id}" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" />
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>